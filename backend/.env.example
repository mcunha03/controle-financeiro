# Copie este arquivo para ".env" e ajuste os valores

# String de conexão do PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/controle_financeiro?schema=public"

# Porta do servidor
PORT=3333

# Segredo usado para assinar os tokens JWT (troque por um valor aleatório forte)
JWT_SECRET="troque-este-valor-por-um-segredo-forte"

# Tempo de expiração do token
JWT_EXPIRES_IN="7d"

# URL do frontend (usada no CORS)
FRONTEND_URL="http://localhost:5173"
